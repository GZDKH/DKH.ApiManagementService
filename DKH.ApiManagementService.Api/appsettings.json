{
  "Application": "DKH.ApiManagementService",
  "Platform": {
    "Auth": {
      "Keycloak": {
        "AuthServerUrl": "http://localhost:8080",
        "Realm": "dkh",
        "ClientId": "dkh-services",
        "RequireHttpsMetadata": false,
        "ValidateAudience": false,
        "ValidateIssuer": false
      },
      "ApiKey": {
        "HeaderName": "X-Api-Key",
        "CacheTtl": "00:01:00",
        "SkipPaths": [
          "/health",
          "/health/ready",
          "/health/live",
          "/ready"
        ]
      }
    },
    "Logging": {
      "MinimumLevel": "Information",
      "OverrideMinimumLevel": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Http": {
      "OpenApi": {
        "Enabled": true,
        "SpecVersion": "OpenApi3_0",
        "JsonRoutePattern": "/openapi/{documentName}.json",
        "ScalarUi": {
          "Enabled": true,
          "EndpointPrefix": "/scalar",
          "Title": "DKH Public API Management"
        },
        "SwaggerUi": {
          "Enabled": true,
          "EndpointPrefix": "/swagger",
          "DocumentTitle": "DKH Public API Management"
        },
        "Documents": [
          {
            "Name": "api-management",
            "Title": "DKH Public API Management",
            "Version": "v1",
            "Description": "Developer-facing API management and public API key operations."
          }
        ]
      }
    }
  },
  "Modularity": {
    "ManifestsDirectory": "Modularity/manifests",
    "EnabledModules": [
      "dkh.api-management",
      "dkh.assistant",
      "dkh.broadcast",
      "dkh.cart",
      "dkh.counterparty",
      "dkh.customers",
      "dkh.customs",
      "dkh.delivery",
      "dkh.inventory",
      "dkh.logistics",
      "dkh.media",
      "dkh.notifications",
      "dkh.orders",
      "dkh.payments",
      "dkh.print",
      "dkh.procurement",
      "dkh.product-catalog",
      "dkh.product-request",
      "dkh.reference",
      "dkh.reviews",
      "dkh.search",
      "dkh.staff",
      "dkh.storefront",
      "dkh.subscription",
      "dkh.telegram-bot",
      "dkh.telegram-client",
      "dkh.warehouse",
      "dkh.engagement"
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=dkh_api_management;Username=postgres;Password="
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  }
}
