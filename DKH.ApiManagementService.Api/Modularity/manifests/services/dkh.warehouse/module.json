{
  "id": "dkh.warehouse",
  "kind": "Service",
  "name": {
    "en": "Warehouse",
    "ru": "Склад"
  },
  "description": {
    "en": "Warehouse operations and stock placement.",
    "ru": "Складские операции и размещение запасов."
  },
  "version": "1.0.0",
  "platformVersion": "1.0.0",
  "author": "GZDKH",
