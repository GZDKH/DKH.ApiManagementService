{
  "id": "dkh.orders",
  "kind": "Service",
  "name": { "en": "Orders", "ru": "Заказы" },
  "description": {
    "en": "Order lifecycle, fulfilment and analytics.",
    "ru": "Жизненный цикл заказов, фулфилмент и аналитика."
  },
  "version": "1.0.0",
  "platformVersion": "1.0.0",
  "author": "GZDKH",
  "category": "Commerce",
  "provides": [
    { "id": "orders.management" }
  ],
  "requires": [
    { "capabilityId": "catalog.products" }
  ],
  "infra": {
    "database": true,
    "queue": true,
    "cache": false,
    "env": ["ConnectionStrings__Orders"]
  },
  "routes": [
    { "path": "/api/v1/orders", "grpcService": "OrderManagementService" }
  ]
}
