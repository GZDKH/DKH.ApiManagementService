{
  "id": "dkh.payments",
  "kind": "Service",
  "name": {
    "en": "Payments",
    "ru": "Платежи"
  },
  "description": {
    "en": "Provider-agnostic checkout and payment processing.",
    "ru": "Провайдеро-независимый чекаут и обработка платежей."
  },
  "version": "1.0.0",
  "platformVersion": "1.0.0",
  "author": "GZDKH",
  "category": "Commerce",
  "provides": [
    {
      "id": "payments.checkout",
      "version": "1.0.0"
    }
  ],
  "requires": [
    {
      "capabilityId": "catalog.products",
      "versionRange": "[3.0.0, )"
    }
  ],
  "infra": {
    "database": true,
    "queue": true,
    "cache": false,
    "env": [
      "ConnectionStrings__Payments"
    ]
  },
  "routes": [
    {
      "path": "/api/v1/payments",
      "grpcService": "PaymentsService"
    }
  ]
}
