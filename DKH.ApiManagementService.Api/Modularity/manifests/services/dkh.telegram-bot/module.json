{
  "id": "dkh.telegram-bot",
  "kind": "Service",
  "name": {
    "en": "Telegram Bot",
    "ru": "Telegram-бот"
  },
  "description": {
    "en": "Telegram bot for notifications and orders.",
    "ru": "Бот Telegram для уведомлений и заказов."
  },
  "version": "1.0.0",
  "platformVersion": "1.0.0",
  "author": "GZDKH",
  "category": "Communications",
  "provides": [
    {
      "id": "telegram.bot"
    }
  ],
  "requires": [
    {
      "capabilityId": "notifications.delivery"
    }
  ],
  "infra": {
    "database": true,
    "queue": true,
    "cache": true,
    "env": [
      "ConnectionStrings__TelegramBot"
    ]
  },
  "routes": [
    {
      "path": "/api/v1/telegram-bot",
      "grpcService": "TelegramBotService"
    }
  ]
}
