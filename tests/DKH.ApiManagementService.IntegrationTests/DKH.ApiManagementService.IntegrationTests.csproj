<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- DKH.Platform.IntegrationTesting 1.0.1 references DKH.Platform.MultiTenancy 1.0.1 which was yanked; 1.1.0 resolves transparently. Suppress NU1603 until DKH.Platform.IntegrationTesting is bumped past 1.0.1. -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory"/>
    <PackageReference Include="NSubstitute"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio"/>
    <PackageReference Include="FluentAssertions"/>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DKH.ApiManagementService.Api\DKH.ApiManagementService.Api.csproj"/>
    <PackageReference Include="DKH.Platform.IntegrationTesting"/>
    <PackageReference Include="DKH.Platform.Grpc.IntegrationTesting"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>
</Project>
